####################################################################
# Historia Dominicana Studio — environment configuration
#
# Copy to `.env` and edit. NEVER commit `.env`.
#
# The defaults below run the whole app locally with NO paid service and
# NO cloud account: local Postgres, local disk, no AI providers, mocked
# publishing. Everything paid is opt-in.
####################################################################

NODE_ENV=development
APP_URL=http://localhost:3000

# ------------------------------------------------------------------
# Database (required)
# ------------------------------------------------------------------
# Local Postgres via `docker compose up -d db`:
DATABASE_URL=postgres://historia:historia@localhost:5432/historia
# Supabase instead (optional, paid tier not required):
# DATABASE_URL=postgres://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# ------------------------------------------------------------------
# Auth
# ------------------------------------------------------------------
# local    = email + password in this app's own users table (no cloud)
# supabase = Supabase Auth (adapter stub; not implemented in Milestone 1)
AUTH_PROVIDER=local

# REQUIRED. Signs the session cookie. Minimum 32 characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars
SESSION_TTL_HOURS=168

# Only when AUTH_PROVIDER=supabase
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Storage
# ------------------------------------------------------------------
# local = plain filesystem (free, the development default)
# s3    = any S3-compatible bucket: Amazon S3, Cloudflare R2, MinIO
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
# Must not exceed the server-action body limit in next.config.mjs (128 MB).
# Ten minutes of mono 24-bit/48 kHz narration is ~86 MB as WAV, ~50 MB as FLAC.
MAX_UPLOAD_MB=128

# Only when STORAGE_DRIVER=s3
# S3_BUCKET=historia-media
# S3_REGION=auto
# S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com   # R2/MinIO; omit for Amazon S3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=

# ------------------------------------------------------------------
# Providers — all optional, all behind interfaces
# ------------------------------------------------------------------
# Scene planning:  manual | mock | openai | anthropic
SCENE_PLAN_PROVIDER=manual
# Titles/descriptions/hashtags: manual | mock | openai | anthropic
COPY_PROVIDER=manual
# Narration:  none | piper (local, free) | elevenlabs | openai
TTS_PROVIDER=none
# Transcription/subtitles:  none | faster_whisper (local, free) | openai
ASR_PROVIDER=none

# Keys are only needed for the paid options above.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# ELEVENLABS_API_KEY=

# ------------------------------------------------------------------
# Local binaries (Milestone 2)
# ------------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# PIPER_PATH=/usr/local/bin/piper
# PIPER_VOICE_PATH=./voices/es_ES-sharvard-medium.onnx
# FASTER_WHISPER_PATH=faster-whisper
WHISPER_MODEL=base

# ------------------------------------------------------------------
# Job queue (Milestone 2) — optional
# ------------------------------------------------------------------
# Leave this unset and renders run inside the app process: no extra service to
# run, but a render is lost if the app restarts mid-encode.
#
# Set it and renders are queued to a BullMQ worker instead, surviving restarts
# and retrying on failure. You must then also run the worker:
#
#   docker compose --profile jobs up -d redis
#   npm run worker
#
# REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------
# Publishing (Milestone 4)
# ------------------------------------------------------------------
# mock = adapters are simulated; nothing is ever sent to a platform
# live = real uploads through official APIs (requires TOKEN_ENCRYPTION_KEY)
PUBLISHING_MODE=mock

# 32 random bytes, base64, for AES-256-GCM encryption of OAuth tokens at rest.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TOKEN_ENCRYPTION_KEY=

# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=http://localhost:3000/api/oauth/youtube/callback

# ------------------------------------------------------------------
# Seed accounts (development only)
# ------------------------------------------------------------------
SEED_OWNER_EMAIL=owner@historia.local
SEED_OWNER_PASSWORD=historia-dev
